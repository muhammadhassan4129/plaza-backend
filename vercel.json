{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "engines": {
    "node": "18.x"
  },
  "crons": [
    {
      "path": "/api/cron/invoices",
      "schedule": "5 19 * * *"
    }
  ]
}